rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ========== GÜVENLİK FONKSİYONLARI ==========
    
    // Admin kontrol fonksiyonu
    function isAdmin() {
      return request.auth != null && (
        // Admin user ID'leri
        request.auth.uid == 'Fu9NlPlGXjQROCW96fZUUTLueUf2' ||
        // Admin email kontrolü
        request.auth.token.email == 'admin@biletsokagi.com' ||
        // Firestore'dan admin rolü kontrolü
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true)
      );
    }
    
    // Email doğrulanmış mı kontrolü
    function isEmailVerified() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    
    // Rate limiting kontrolü - Belirli bir süre içindeki işlem sayısını kontrol eder
    function checkWriteRateLimit(collection, maxWrites, timeWindowMinutes) {
      return request.auth != null && !exists(/databases/$(database)/documents/rateLimits/$(request.auth.uid + '_' + collection + '_writes'));
    }
    
    // Request size kontrolü - Çok büyük veri gönderimini engeller
    function isValidRequestSize() {
      return request.resource.size < 1 * 1024 * 1024; // Max 1MB
    }
    
    // Field sayısı kontrolü - Çok fazla field ile spam önleme
    function hasReasonableFieldCount() {
      return request.resource.data.keys().size() > 0 && 
             request.resource.data.keys().size() < 50;
    }
    
    // Kullanıcı banlı mı kontrolü
    function isNotBanned() {
      return request.auth != null &&
        (!exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.banned != true);
    }
    
    // Genel güvenlik kontrolü
    function passesSecurityChecks() {
      // TODO: isEmailVerified() kontrolünü prod ortamında yeniden aktif et
      return isNotBanned() && 
             isValidRequestSize() && 
             hasReasonableFieldCount();
    }
    
    // Kullanıcı dokümanları - Herkes okuyabilir, sadece kendi verisini yazabilir
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (
        request.auth.uid == userId ||
        // Admin kullanıcılar tüm user dokümanlarını güncelleyebilir (ban/unban için)
        isAdmin()
      );
    }
    
    // Conversation dokümanları - Sadece participants veya buyer/seller okuyabilir/güncelleyebilir
    match /conversations/{conversationId} {
      allow read, update: if request.auth != null && (
        request.auth.uid in resource.data.participants ||
        request.auth.uid == resource.data.buyerId ||
        request.auth.uid == resource.data.sellerId
      );
      
      allow create: if request.auth != null && (
        // Yeni kurala göre participants + createdBy
        (
          request.auth.uid in request.resource.data.participants &&
          request.resource.data.createdBy == request.auth.uid
        ) ||
        // Eski şema ile uyumluluk: buyerId/sellerId üzerinden
        request.auth.uid == request.resource.data.buyerId ||
        request.auth.uid == request.resource.data.sellerId
      );
      
      allow delete: if request.auth != null && (
        request.auth.uid in resource.data.participants ||
        request.auth.uid == resource.data.buyerId ||
        request.auth.uid == resource.data.sellerId
      );
      
      // Conversation içindeki messages sub-collection kuralları
      match /messages/{messageId} {
        allow read: if request.auth != null && 
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        
        // Rate limiting: Dakikada maksimum 30 mesaj
        allow create: if request.auth != null && 
          passesSecurityChecks() &&
          checkWriteRateLimit('messages', 30, 1) &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants &&
          request.resource.data.senderId == request.auth.uid &&
          // Mesaj boyutu kontrolü (max 10KB)
          request.resource.data.text.size() < 10000;
        
        allow update: if request.auth != null && 
          request.auth.uid == resource.data.senderId;
        
        allow delete: if request.auth != null && 
          request.auth.uid == resource.data.senderId;
      }
      
      // Typing indicators sub-collection kuralları
      match /typingIndicators/{userId} {
        allow read: if request.auth != null && 
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        
        allow write: if request.auth != null && 
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants &&
          request.auth.uid == userId;
      }
    }
    
    // Mesaj dokümanları - Yalnızca mesajın tarafları okuyabilir/yazabilir
    match /messages/{messageId} {
      // Okuma, sadece gönderici veya alıcı için
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.senderId ||
        request.auth.uid == resource.data.receiverId ||
        // Conversation participants kontrolü (eğer conversationId varsa)
        ('conversationId' in resource.data && 
         exists(/databases/$(database)/documents/conversations/$(resource.data.conversationId)) &&
         request.auth.uid in get(/databases/$(database)/documents/conversations/$(resource.data.conversationId)).data.participants)
      );

      // Oluşturma, yalnızca gönderen tarafından yapılabilir
      allow create: if request.auth != null && 
        request.resource.data.senderId == request.auth.uid &&
        // receiverId alanı zorunlu ve kendisi dışındaki bir kullanıcı olmalı
        request.resource.data.receiverId != null &&
        request.resource.data.receiverId != request.auth.uid &&
        // ConversationId varsa participants kontrolü
        (!('conversationId' in request.resource.data) || 
         (exists(/databases/$(database)/documents/conversations/$(request.resource.data.conversationId)) &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(request.resource.data.conversationId)).data.participants));

      // Güncelle/silme sadece gönderen tarafından
      allow update, delete: if request.auth != null && 
        request.auth.uid == resource.data.senderId;
    }
    
    // Read receipt dokümanları - Sadece message participants erişebilir
    match /readReceipts/{receiptId} {
      allow read: if request.auth != null && 
        request.auth.uid in get(/databases/$(database)/documents/conversations/$(resource.data.conversationId)).data.participants;
      
      allow create: if request.auth != null && 
        request.auth.uid == request.resource.data.userId &&
        request.auth.uid in get(/databases/$(database)/documents/conversations/$(request.resource.data.conversationId)).data.participants;
      
      allow update, delete: if request.auth != null && 
        request.auth.uid == resource.data.userId;
    }
    
    // Notification dokümanları - Sadece receiver erişebilir
    match /notifications/{notificationId} {
      allow read, update, delete: if request.auth != null && 
        request.auth.uid == resource.data.receiverId;
      
      allow create: if request.auth != null && 
        request.auth.uid == request.resource.data.senderId;
    }
    
    // Ticket dokümanları - Genel okuma, sahip yazma ve locking
    match /tickets/{ticketId} {
      // Herkes biletleri görebilir (marketplace mantığı)
      allow read: if true;
      
      // Sadece authenticated ve güvenlik kontrollerini geçen kullanıcılar bilet oluşturabilir
      // Rate limiting: Saatte maksimum 10 bilet
      allow create: if request.auth != null && (
        isAdmin() || (
          passesSecurityChecks() &&
          checkWriteRateLimit('tickets', 10, 60) &&
          request.resource.data.sellerId == request.auth.uid &&
          request.resource.data.status in ['available', 'draft'] &&
          (!exists(/databases/$(database)/documents/tickets/$(request.auth.uid + '_' + request.resource.data.title + '_recent')) ||
           get(/databases/$(database)/documents/tickets/$(request.auth.uid + '_' + request.resource.data.title + '_recent')).data.createdAt < request.time - duration.value(5, 'm'))
        )
      );
      
      // Güncellemeler için detaylı kurallar
      allow update: if request.auth != null && (
        // Satıcı kendi biletini güncelleyebilir
        (request.auth.uid == resource.data.sellerId && 
         resource.data.status != 'sold') ||
        // Alıcı sadece satın alma işleminde güncelleyebilir
        (request.auth.uid == request.resource.data.buyerId && 
         request.resource.data.status == 'sold' &&
         resource.data.status == 'available') ||
        // Lock mekanizması için
        ('lockUntil' in request.resource.data && 
         request.auth.uid != null &&
         resource.data.status == 'available')
      );
      
      // Sadece satıcı silebilir ve bilet satılmamış olmalı
      allow delete: if request.auth != null && 
        request.auth.uid == resource.data.sellerId &&
        resource.data.status != 'sold';
    }
    
    // Order dokümanları - Sadece buyer ve seller erişebilir
    match /orders/{orderId} {
      allow read, update: if request.auth != null && 
        (request.auth.uid == resource.data.buyerId || 
         request.auth.uid == resource.data.sellerId);
      
      allow create: if request.auth != null && 
        request.auth.uid == request.resource.data.buyerId;
      
      allow delete: if request.auth != null && 
        request.auth.uid == resource.data.buyerId;
    }
    
    // Transaction dokümanları - Sadece ilgili taraflar erişebilir
    match /transactions/{transactionId} {
      allow read: if request.auth != null && 
        (request.auth.uid == resource.data.buyerId || 
         request.auth.uid == resource.data.sellerId);
      
      allow create: if request.auth != null && 
        (request.auth.uid == request.resource.data.buyerId || 
         request.auth.uid == request.resource.data.sellerId);
      
      allow update: if request.auth != null && 
        (request.auth.uid == resource.data.buyerId || 
         request.auth.uid == resource.data.sellerId);
    }
    
    // Review dokümanları - Genel okuma, sahip yazma
    match /reviews/{reviewId} {
      allow read: if request.auth != null;
      
      allow create: if request.auth != null && 
        request.resource.data.reviewerId == request.auth.uid;
      
      allow update, delete: if request.auth != null && 
        request.auth.uid == resource.data.reviewerId;
    }
    
    // Report dokümanları - Reporter ve admin erişebilir
    match /reports/{reportId} {
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.reporterId ||
        isAdmin()
      );
      
      allow create: if request.auth != null && 
        request.resource.data.reporterId == request.auth.uid;
      
      allow update: if request.auth != null && (
        request.auth.uid == resource.data.reporterId ||
        isAdmin()
      );
      
      allow delete: if request.auth != null && (
        request.auth.uid == resource.data.reporterId ||
        isAdmin()
      );
    }
    
    // Category dokümanları - Genel okuma
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if false; // Sadece admin panelinden yönetilir
    }
    
    // Event dokümanları - Genel okuma
    match /events/{eventId} {
      allow read: if true;
      allow write: if false; // Sadece admin panelinden yönetilir
    }
    
    // Venue dokümanları - Genel okuma
    match /venues/{venueId} {
      allow read: if true;
      allow write: if false; // Sadece admin panelinden yönetilir
    }
    
    // Likes koleksiyonu - Public read, only authenticated users can like/unlike
    match /likes/{likeId} {
      allow read: if true;
      allow create: if request.auth != null && 
        request.resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null && 
        request.auth.uid == resource.data.userId;
    }
    
    // Checkout sessions - Authenticated users can create/read their own
    match /checkout_sessions/{sessionId} {
      allow read, update: if request.auth != null && 
        (request.auth.uid == resource.data.buyerId || 
         request.auth.uid == resource.data.sellerId);
      allow create: if request.auth != null && 
        request.resource.data.buyerId == request.auth.uid;
    }
    
    // Payments - Authenticated users can read their own payments
    match /payments/{paymentId} {
      allow read: if request.auth != null && 
        (request.auth.uid == resource.data.payerId || 
         request.auth.uid == resource.data.payeeId);
      allow create: if request.auth != null && 
        (request.auth.uid == request.resource.data.payerId || 
         request.auth.uid == request.resource.data.payeeId);
    }
    
    // Username index - Public read for mapping username -> uid/email during pre-auth login
    match /usernameIndex/{username} {
      // Allow anyone to read username mapping to support username-based login
      allow read: if true;
      
      // Username oluşturma ve güncelleme kuralları
      allow create: if request.auth != null && (
        // Kullanıcı kendi username'ini oluşturabilir
        request.auth.uid == request.resource.data.uid &&
        username == request.resource.data.username &&
        // Username formatı kontrolü (alfanumerik ve alt çizgi)
        username.matches('^[a-zA-Z0-9_]{3,20}$')
      );
      
      allow update: if request.auth != null && (
        // Sadece kendi username mapping'ini güncelleyebilir
        request.auth.uid == resource.data.uid &&
        request.auth.uid == request.resource.data.uid &&
        // UID değiştirilemez
        resource.data.uid == request.resource.data.uid
      );
      
      // Sadece sahip veya admin silebilir
      allow delete: if request.auth != null &&
                    request.auth.uid == resource.data.uid;
    }
    // UserProfiles koleksiyonu - Genişletilmiş profil bilgileri
    match /userProfiles/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // NotificationSettings koleksiyonu
    match /notificationSettings/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // PushNotifications koleksiyonu
    match /pushNotifications/{notificationId} {
      allow read: if request.auth != null && 
        request.auth.uid == resource.data.userId;
      allow create: if request.auth != null;
      allow update, delete: if false; // Sadece backend tarafından yönetilir
    }
    
    // Bans koleksiyonu - Sadece admin erişebilir
    match /bans/{banId} {
      allow read, write: if isAdmin();
    }
    
    // Admin işlemleri için genel koleksiyonlar
    match /adminLogs/{logId} {
      allow read, write: if isAdmin();
    }
    
    // System statistics - Admin only
    match /systemStats/{statId} {
      allow read, write: if isAdmin();
    }
    
    // Rate limiting kayıtları - Sadece sistem yazabilir, kullanıcılar okuyamaz
    match /rateLimits/{documentId} {
      allow read: if false; // Kullanıcılar okuyamaz
      allow write: if false; // Sadece Cloud Functions yazabilir
    }
    
    // Bot aktivitesi logları - Sadece adminler okuyabilir
    match /botActivity/{activityId} {
      allow read: if isAdmin();
      allow write: if false; // Sadece Cloud Functions yazabilir
    }
    
    // Güvenlik logları - Sadece adminler okuyabilir
    match /securityLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false; // Sadece Cloud Functions yazabilir
    }
    
    // Fraud analysis kayıtları - Sistem tarafından yazılır, adminler okuyabilir
    match /fraudAnalysis/{analysisId} {
      allow read: if isAdmin() || 
        (request.auth != null && request.auth.uid == resource.data.userId);
      allow write: if request.auth != null; // Sistem tarafından yazılabilir
    }
    
    // 2FA configurations - Sadece kullanıcının kendisi erişebilir
    match /twoFactorConfigs/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // 2FA pending verifications - Geçici doğrulama kayıtları
    match /pending2FAVerifications/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // SMS verification codes - Geçici SMS kodları
    match /smsVerificationCodes/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Email verification codes - Geçici email kodları
    match /emailVerificationCodes/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
