// Express route to get image variants
app.get('/image-variants', async (req: Request, res: Response) => {
  try {
    const { imagePath } = req.query;
    
    if (!imagePath) {
      res.status(400).json({ error: 'Image path is required' });
      return;
    }

    const bucket = admin.storage().bucket();
    const fileName = path.basename(imagePath as string);
    const fileDir = path.dirname(imagePath as string);
    
    const thumbFilePath = `${fileDir}/thumbnails/thumb_${fileName}`;
    const compressedFilePath = `${fileDir}/compressed/compressed_${fileName}`;
    
    const variants = {
      original: imagePath,
      thumbnail: null as string | null,
      compressed: null as string | null
    };

    // Check if thumbnail exists
    try {
      const [thumbExists] = await bucket.file(thumbFilePath).exists();
      if (thumbExists) {
        const [thumbUrl] = await bucket.file(thumbFilePath).getSignedUrl({
          action: 'read',
          expires: Date.now() + 24 * 60 * 60 * 1000 // 24 hours
        });
        variants.thumbnail = thumbUrl;
      }
    } catch (error) {
      console.log('Thumbnail not found:', (error as Error).message);
    }

    // Check if compressed version exists
    try {
      const [compressedExists] = await bucket.file(compressedFilePath).exists();
      if (compressedExists) {
        const [compressedUrl] = await bucket.file(compressedFilePath).getSignedUrl({
          action: 'read',
          expires: Date.now() + 24 * 60 * 60 * 1000 // 24 hours
        });
        variants.compressed = compressedUrl;
      }
    } catch (error) {
      console.log('Compressed version not found:', (error as Error).message);
    }

    res.json(variants);
  } catch (error) {
    console.error('Error getting image variants:', error);
    res.status(500).json({ error: 'Internal server error' });
  }
});

// GET /v1/conversations - Kullanıcının conversation'larını getir
app.get('/v1/conversations',
  authMiddleware,
  asyncHandler(async (req: any, res: Response) => {
    const userId = req.user.uid;
    const { limit = 20, cursor } = req.query;

    let query = db.collection('conversations')
      .where('participants', 'array-contains', userId)
      .orderBy('updatedAt', 'desc')
      .limit(parseInt(limit as string));

    if (cursor) {
      query = query.startAfter(cursor);
    }

    const snapshot = await query.get();
    const conversations = snapshot.docs.map(doc => ({
      id: doc.id,
      ...doc.data()
    }));

    return successResponse(res, conversations, 'Conversations başarıyla getirildi');
  })
);

// POST /v1/conversations - Yeni conversation oluştur
app.post('/v1/conversations',
  [
    body('participants').isArray().withMessage('Participants array gerekli'),
    body('participants').isLength({ min: 2 }).withMessage('En az 2 participant gerekli'),
    body('title').optional().isString(),
    body('type').optional().isIn(['private', 'group']).withMessage('Type private veya group olmalı')
  ],
  authMiddleware,
  validationHandler,
  asyncHandler(async (req: any, res: Response) => {
    const { participants, title, type = 'private' } = req.body;
    const creatorId = req.user.uid;

    // Creator'ı participants listesine ekle
    const allParticipants = [...new Set([...participants, creatorId])];

    const newConversation: ConversationData = {
      participants: allParticipants,
      title: title || null,
      type,
      createdBy: creatorId,
      createdAt: admin.firestore.FieldValue.serverTimestamp(),
      updatedAt: admin.firestore.FieldValue.serverTimestamp(),
      lastMessage: null,
      isActive: true
    };

    const docRef = await db.collection('conversations').add(newConversation);
    const conversationData = { id: docRef.id, ...newConversation };

    // WebSocket event'i yayınla - Yeni conversation oluşturuldu
    allParticipants.forEach(participantId => {
      emitToUser(participantId, 'conversation:created', {
        conversationId: docRef.id,
        conversation: conversationData,
        createdBy: creatorId,
        timestamp: Date.now()
      });
    });

    console.log(`WebSocket event emitted: conversation:created for conversation ${docRef.id}`);

    return successResponse(res, conversationData, 'Conversation başarıyla oluşturuldu', 201);
  })
);

// PUT /v1/conversations/:cid - Conversation güncelle
app.put('/v1/conversations/:cid',
  [
    param('cid').notEmpty().withMessage('Conversation ID gerekli'),
    body('title').optional().isString(),
    body('participants').optional().isArray()
  ],
  authMiddleware,
  validationHandler,
  asyncHandler(async (req: any, res: Response) => {
    const { cid } = req.params;
    const { title, participants } = req.body;
    const userId = req.user.uid;

    const conversationRef = db.collection('conversations').doc(cid);
    const conversationDoc = await conversationRef.get();

    if (!conversationDoc.exists) {
      return notFoundResp(res, 'Conversation bulunamadı');
    }

    const conversationData = conversationDoc.data() as ConversationData;
    if (!conversationData.participants.includes(userId)) {
      return forbiddenResponse(res, 'Bu conversation\'ı güncelleme yetkiniz yok');
    }

    const updateData: Partial<ConversationData> = {
      updatedAt: admin.firestore.FieldValue.serverTimestamp()
    };

    if (title !== undefined) updateData.title = title;
    if (participants !== undefined) updateData.participants = participants;

    await conversationRef.update(updateData);

    const updatedConversationData = { id: cid, ...conversationData, ...updateData };

    // WebSocket event'i yayınla - Conversation güncellendi
    const targetParticipants = participants || conversationData.participants;
    targetParticipants.forEach((participantId: string) => {
      emitToUser(participantId, 'conversation:updated', {
        conversationId: cid,
        conversation: updatedConversationData,
        updatedBy: userId,
        changes: { title, participants },
        timestamp: Date.now()
      });
    });

    console.log(`WebSocket event emitted: conversation:updated for conversation ${cid}`);

    return successResponse(res, updatedConversationData, 'Conversation başarıyla güncellendi');
  })
);

// DELETE /v1/conversations/:cid - Conversation sil
app.delete('/v1/conversations/:cid',
  [
    param('cid').notEmpty().withMessage('Conversation ID gerekli')
  ],
  authMiddleware,
  async (req: any, res: Response) => {
    const errors = validationResult(req);
    if (!errors.isEmpty()) {
      return res.status(400).json({ success: false, error: errors.array() });
    }

    try {
      const { cid } = req.params;
      const userId = req.user.uid;

      const conversationRef = db.collection('conversations').doc(cid);
      const conversationDoc = await conversationRef.get();

      if (!conversationDoc.exists) {
        return res.status(404).json({ success: false, error: 'Conversation bulunamadi' });
      }

      const conversationData = conversationDoc.data() as ConversationData;
      if (!conversationData.participants.includes(userId)) {
        return res.status(403).json({ success: false, error: 'Bu conversation\'ı silme yetkiniz yok' });
      }

      // Conversation'ı soft delete yap
      await conversationRef.update({
        isActive: false,
        deletedAt: admin.firestore.FieldValue.serverTimestamp(),
        deletedBy: userId
      });

      // WebSocket event'i yayınla - Conversation silindi
      conversationData.participants.forEach(participantId => {
        emitToUser(participantId, 'conversation:deleted', {
          conversationId: cid,
          deletedBy: userId,
          timestamp: Date.now()
        });
      });

      console.log(`WebSocket event emitted: conversation:deleted for conversation ${cid}`);

      res.json({ success: true, data: { id: cid }, error: null });
    } catch (error) {
      res.status(500).json({ success: false, error: (error as Error).message });
    }
  }
);

// GET /v1/conversations/:cid/messages
app.get('/v1/conversations/:cid/messages',
  [
    param('cid').notEmpty().withMessage('Conversation ID gerekli'),
    query('limit').isInt({ min: 1 }).optional(),
    query('cursor').optional()
  ],
  authMiddleware,
  validationHandler,
  asyncHandler(async (req: any, res: Response) => {
    const { cid } = req.params;
    const { limit = 10, cursor } = req.query;
    const userId = req.user.uid;

    // Conversation erişim yetkisi kontrolü
    const conversationRef = db.collection('conversations').doc(cid);
    const conversationDoc = await conversationRef.get();
    
    if (!conversationDoc.exists) {
      return notFoundResp(res, 'Conversation bulunamadı');
    }
    
    const conversationData = conversationDoc.data() as ConversationData;
    if (!conversationData.participants.includes(userId)) {
      return forbiddenResponse(res, 'Bu conversation\'a erişim yetkiniz yok');
    }

    const messagesRef = db.collection('messages').where('conversationId', '==', cid);
    let query = messagesRef.orderBy('timestamp').limit(parseInt(limit as string));

    if (cursor) {
      query = query.startAfter(cursor);
    }

    const snapshot = await query.get();
    const messages = snapshot.docs.map(doc => doc.data());

    // Sayfalama bilgisiyle birlikte yanıt
    const pagination = {
      limit: parseInt(limit as string),
      hasNext: snapshot.docs.length === parseInt(limit as string),
      ...(cursor && { cursor })
    };

    return paginatedResponse(res, messages, pagination, 'Mesajlar başarıyla getirildi');
  })
);

// POST /v1/conversations/:cid/messages
app.post('/v1/conversations/:cid/messages',
  [
    param('cid').notEmpty().withMessage('Conversation ID gerekli'),
    body('content').notEmpty().withMessage('Mesaj içeriği gerekli')
  ],
  authMiddleware,
  validationHandler,
  asyncHandler(async (req: any, res: Response) => {
    const { cid } = req.params;
    const { content } = req.body;
    const senderId = req.user.uid;
    
    // Conversation erişim yetkisi kontrolü
    const conversationRef = db.collection('conversations').doc(cid);
    const conversationDoc = await conversationRef.get();
    
    if (!conversationDoc.exists) {
      return notFoundResp(res, 'Conversation bulunamadı');
    }
    
    const conversationData = conversationDoc.data() as ConversationData;
    if (!conversationData.participants.includes(senderId)) {
      return forbiddenResponse(res, 'Bu conversation\'a mesaj gönderme yetkiniz yok');
    }

    const newMessage: MessageData = {
      conversationId: cid,
      senderId,
      content,
      timestamp: admin.firestore.FieldValue.serverTimestamp()
    };

    const docRef = await db.collection('messages').add(newMessage);
    
    // WebSocket event'i yayınla - Yeni mesaj
    const messageData = { id: docRef.id, ...newMessage };
    io.to(cid).emit('message:created', {
      messageId: docRef.id,
      conversationId: cid,
      senderId,
      content,
      timestamp: Date.now(),
      message: messageData
    });
    
    console.log(`WebSocket event emitted: message:created for conversation ${cid}`);

    return successResponse(res, messageData, 'Mesaj başarıyla gönderildi', 201);
  })
);

// ReadReceipt ve Reaction Yardımcı Fonksiyonları

/**
 * Read receipt oluşturur
 * @param messageId - Mesaj ID'si
 * @param userId - Kullanıcı ID'si
 * @param conversationId - Konuşma ID'si
 * @returns Read receipt bilgisi
 */
async function createReadReceipt(messageId: string, userId: string, conversationId: string) {
  try {
    const readReceiptData: ReadReceiptData = {
      messageId,
      userId,
      conversationId,
      readAt: admin.firestore.FieldValue.serverTimestamp()
    };

    const readReceiptRef = await db.collection('readReceipts').add(readReceiptData);
    console.log(`Read receipt created for message ${messageId} by user ${userId}`);
    
    return { id: readReceiptRef.id, ...readReceiptData };
  } catch (error) {
    console.error('Error creating read receipt:', error);
    throw error;
  }
}

/**
 * Mesaj durumunu günceller
 * @param messageId - Mesaj ID'si
 * @param status - Yeni durum (sent, delivered, read)
 * @param userId - Kullanıcı ID'si (opsiyonel)
 * @returns Güncellenen mesaj bilgisi
 */
async function updateMessageStatus(messageId: string, status: 'sent' | 'delivered' | 'read', userId?: string) {
  try {
    const messageRef = db.collection('messages').doc(messageId);
    const messageDoc = await messageRef.get();
    
    if (!messageDoc.exists) {
      throw new Error('Mesaj bulunamadı');
    }

    const updateData: any = {
      status,
      statusUpdatedAt: admin.firestore.FieldValue.serverTimestamp()
    };

    // Eğer status 'read' ise ve userId varsa, readBy array'ini güncelle
    if (status === 'read' && userId) {
      updateData.readBy = admin.firestore.FieldValue.arrayUnion(userId);
    }

    await messageRef.update(updateData);
    console.log(`Message ${messageId} status updated to ${status}`);
    
    return { id: messageId, status, userId };
  } catch (error) {
    console.error('Error updating message status:', error);
    throw error;
  }
}

/**
 * Mesaj reaksiyonunu toggle eder (ekle/kaldır)
 * @param messageId - Mesaj ID'si
 * @param emoji - Emoji karakteri
 * @param userId - Kullanıcı ID'si
 * @returns Güncellenmiş reaksiyon bilgisi
 */
async function toggleReaction(messageId: string, emoji: string, userId: string) {
  try {
    const messageRef = db.collection('messages').doc(messageId);
    const messageDoc = await messageRef.get();
    
    if (!messageDoc.exists) {
      throw new Error('Mesaj bulunamadı');
    }

    const messageData = messageDoc.data() as MessageData;
    const currentReactions = messageData.reactions || [];
    
    // Kullanıcının bu emoji için mevcut reaksiyonunu kontrol et
    const existingReactionIndex = currentReactions.findIndex(
      reaction => reaction.emoji === emoji && reaction.userId === userId
    );

    let action: 'added' | 'removed';
    let updatedReactions: ReactionData[];

    if (existingReactionIndex !== -1) {
      // Reaksiyon varsa, kaldır
      updatedReactions = currentReactions.filter(
        (reaction, index) => index !== existingReactionIndex
      );
      action = 'removed';
    } else {
      // Reaksiyon yoksa, ekle
      updatedReactions = [...currentReactions, {
        emoji,
        userId,
        createdAt: admin.firestore.FieldValue.serverTimestamp()
      }];
      action = 'added';
    }

    await messageRef.update({ reactions: updatedReactions });
    console.log(`Reaction ${action} for message ${messageId} by user ${userId}`);
    
    return { messageId, emoji, userId, action };
  } catch (error) {
    console.error('Error toggling reaction:', error);
    throw error;
  }
}

// ReadReceipt ve Reaction endpoint'lerini güncelle

// PUT /v1/messages/:mid/read - Geliştirilmiş read receipt
app.put('/v1/messages/:mid/read',
  [
    param('mid').notEmpty().withMessage('Message ID gerekli')
  ],
  authMiddleware,
  async (req: any, res: Response) => {
    const errors = validationResult(req);
    if (!errors.isEmpty()) {
      return res.status(400).json({ success: false, error: errors.array() });
    }

    try {
      const { mid } = req.params;
      const receiverId = req.user.uid;

      const messageRef = db.collection('messages').doc(mid);
      const messageDoc = await messageRef.get();

      if (!messageDoc.exists) {
        return res.status(404).json({ success: false, error: 'Mesaj bulunamadi' });
      }

      const messageData = messageDoc.data() as MessageData;
      const conversationId = messageData.conversationId;

      // Mesaj durumunu güncelle
      await updateMessageStatus(mid, 'read', receiverId);

      // Read receipt oluştur
      const readReceipt = await createReadReceipt(mid, receiverId, conversationId);
      
      // WebSocket event'i yayınla - Mesaj okundu
      io.to(conversationId).emit('message:read', {
        messageId: mid,
        conversationId,
        userId: receiverId,
        readReceipt,
        timestamp: Date.now()
      });
      
      console.log(`WebSocket event emitted: message:read for conversation ${conversationId}`);

      res.json({ 
        success: true, 
        data: { 
          messageId: mid, 
          readReceipt 
        }, 
        error: null 
      });
    } catch (error) {
      res.status(500).json({ success: false, error: (error as Error).message });
    }
  }
);

// POST /v1/messages/:mid/reactions - Geliştirilmiş reaction toggle
app.post('/v1/messages/:mid/reactions',
  [
    param('mid').notEmpty().withMessage('Message ID gerekli'),
    body('emoji').notEmpty().withMessage('Emoji gerekli')
  ],
  authMiddleware,
  async (req: any, res: Response) => {
    const errors = validationResult(req);
    if (!errors.isEmpty()) {
      return res.status(400).json({ success: false, error: errors.array() });
    }

    try {
      const { mid } = req.params;
      const { emoji } = req.body;
      const userId = req.user.uid;

      const result = await toggleReaction(mid, emoji, userId);
      
      // Mesaj bilgisini al conversation ID için
      const messageRef = db.collection('messages').doc(mid);
      const messageDoc = await messageRef.get();
      const messageData = messageDoc.data() as MessageData;
      
      // WebSocket event'i yayınla - Reaksiyon eklendi/kaldırıldı
      io.to(messageData.conversationId).emit('message:reaction', {
        messageId: mid,
        conversationId: messageData.conversationId,
        userId,
        emoji,
        action: result.action,
        timestamp: Date.now()
      });
      
      console.log(`WebSocket event emitted: message:reaction (${result.action}) for conversation ${messageData.conversationId}`);

      res.json({ 
        success: true, 
        data: result, 
        error: null 
      });
    } catch (error) {
      res.status(500).json({ success: false, error: (error as Error).message });
    }
  }
);

// GET /v1/messages/:mid/read-receipts - Read receipt'leri getir
app.get('/v1/messages/:mid/read-receipts',
  [
    param('mid').notEmpty().withMessage('Message ID gerekli')
  ],
  authMiddleware,
  async (req: any, res: Response) => {
    const errors = validationResult(req);
    if (!errors.isEmpty()) {
      return res.status(400).json({ success: false, error: errors.array() });
    }

    try {
      const { mid } = req.params;
      const userId = req.user.uid;

      // Mesajın varlığını ve erişim yetkisini kontrol et
      const messageRef = db.collection('messages').doc(mid);
      const messageDoc = await messageRef.get();

      if (!messageDoc.exists) {
        return res.status(404).json({ success: false, error: 'Mesaj bulunamadi' });
      }

      const messageData = messageDoc.data() as MessageData;
      const conversationId = messageData.conversationId;

      // Konuşma erişim yetkisi kontrolü
      const conversationRef = db.collection('conversations').doc(conversationId);
      const conversationDoc = await conversationRef.get();
      
      if (!conversationDoc.exists) {
        return res.status(404).json({ success: false, error: 'Conversation bulunamadi' });
      }
      
      const conversationData = conversationDoc.data() as ConversationData;
      if (!conversationData.participants.includes(userId)) {
        return res.status(403).json({ success: false, error: 'Bu mesaja erisim yetkiniz yok' });
      }

      // Read receipt'leri getir
      const readReceiptsSnapshot = await db.collection('readReceipts')
        .where('messageId', '==', mid)
        .orderBy('readAt', 'desc')
        .get();

      const readReceipts = readReceiptsSnapshot.docs.map(doc => ({
        id: doc.id,
        ...doc.data()
      }));

      res.json({ 
        success: true, 
        data: readReceipts, 
        error: null 
      });
    } catch (error) {
      res.status(500).json({ success: false, error: (error as Error).message });
    }
  }
);

// GET /v1/messages/:mid/reactions - Mesaj reaksiyonlarını getir
app.get('/v1/messages/:mid/reactions',
  [
    param('mid').notEmpty().withMessage('Message ID gerekli')
  ],
  authMiddleware,
  async (req: any, res: Response) => {
    const errors = validationResult(req);
    if (!errors.isEmpty()) {
      return res.status(400).json({ success: false, error: errors.array() });
    }

    try {
      const { mid } = req.params;
      const userId = req.user.uid;

      // Mesajın varlığını ve erişim yetkisini kontrol et
      const messageRef = db.collection('messages').doc(mid);
      const messageDoc = await messageRef.get();

      if (!messageDoc.exists) {
        return res.status(404).json({ success: false, error: 'Mesaj bulunamadi' });
      }

      const messageData = messageDoc.data() as MessageData;
      const conversationId = messageData.conversationId;

      // Konuşma erişim yetkisi kontrolü
      const conversationRef = db.collection('conversations').doc(conversationId);
      const conversationDoc = await conversationRef.get();
      
      if (!conversationDoc.exists) {
        return res.status(404).json({ success: false, error: 'Conversation bulunamadi' });
      }
      
      const conversationData = conversationDoc.data() as ConversationData;
      if (!conversationData.participants.includes(userId)) {
        return res.status(403).json({ success: false, error: 'Bu mesaja erisim yetkiniz yok' });
      }

      // Mesaj reaksiyonlarını getir
      const reactions = messageData.reactions || [];
      
      // Reaksiyonları emoji'ye göre grupla
      const groupedReactions = reactions.reduce((acc: any, reaction: ReactionData) => {
        if (!acc[reaction.emoji]) {
          acc[reaction.emoji] = [];
        }
        acc[reaction.emoji].push({
          userId: reaction.userId,
          createdAt: reaction.createdAt
        });
        return acc;
      }, {});

      res.json({ 
        success: true, 
        data: {
          messageId: mid,
          reactions: groupedReactions,
          totalReactions: reactions.length
        }, 
        error: null 
      });
    } catch (error) {
      res.status(500).json({ success: false, error: (error as Error).message });
    }
  }
);

// Global error handler middleware'lerini ekle
app.use(notFoundHandler); // 404 handler - tüm route'lardan sonra
app.use(errorHandler); // Global error handler - en sonda

// Firebase Cloud Functions kullanarak HTTP sunucusunu çalıştırın
const httpsOptions: HttpsOptions = {
  memory: '512MiB',
  timeoutSeconds: 60
};

export const api = onRequest(httpsOptions, app);

// Yardımcı fonksiyonları export et
export { createReadReceipt, updateMessageStatus, toggleReaction };
