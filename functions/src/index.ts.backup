// Socket.IO middleware - Token doğrulama
// TEMPORARILY DISABLED FOR FIREBASE FUNCTIONS DEPLOYMENT
// Mock io to prevent errors
const io: any = { use: () => {}, on: () => {} };

const authenticateSocket = async (socket: any, next: (err?: Error) => void) => {
  try {
    const token = socket.handshake.auth.token;
    
    if (!token) {
      return next(new Error('Authentication error: Token gerekli'));
    }
    
    const decodedToken = await admin.auth().verifyIdToken(token);
    socket.user = decodedToken;
    
    next();
  } catch (error) {
    console.error('Socket authentication error:', error);
    next(new Error('Authentication error: Geçersiz token'));
  }
};

// Socket.IO auth middleware'i uygula
io.use(authenticateSocket);

// Aktif kullanıcıları takip et
const activeUsers = new Map<string, SocketUser>();

// Socket.IO bağlantı yönetimi
io.on('connection', (socket: any) => {
  console.log(`User connected: ${socket.user.uid}`);
  
  // Kullanıcıyı aktif kullanıcılar listesine ekle
  activeUsers.set(socket.user.uid, {
    socketId: socket.id,
    user: socket.user,
    lastSeen: Date.now()
  });
  
  // Kullanıcının online durumunu broadcast et
  socket.broadcast.emit('user:online', {
    userId: socket.user.uid,
    timestamp: Date.now()
  });
  
  // Conversation'a katılma
  socket.on('joinConversation', async (conversationId: string) => {
    try {
      // Conversation erişim yetkisi kontrolü
      const conversationRef = db.collection('conversations').doc(conversationId);
      const conversationDoc = await conversationRef.get();
      
      if (!conversationDoc.exists) {
        socket.emit('error', { message: 'Conversation bulunamadı' });
        return;
      }
      
      const conversationData = conversationDoc.data() as ConversationData;
      if (!conversationData.participants.includes(socket.user.uid)) {
        socket.emit('error', { message: 'Bu conversation\'a erişim yetkiniz yok' });
        return;
      }
      
      // Conversation odasına katıl
      socket.join(conversationId);
      console.log(`User ${socket.user.uid} joined conversation ${conversationId}`);
      
      // Diğer katılımcılara kullanıcının conversation'a katıldığını bildir
      socket.to(conversationId).emit('user:joined', {
        userId: socket.user.uid,
        conversationId,
        timestamp: Date.now()
      });
      
    } catch (error) {
      console.error('Join conversation error:', error);
      socket.emit('error', { message: 'Conversation\'a katılma hatası' });
    }
  });
  
  // Conversation'dan ayrılma
  socket.on('leaveConversation', (conversationId: string) => {
    socket.leave(conversationId);
    console.log(`User ${socket.user.uid} left conversation ${conversationId}`);
    
    // Diğer katılımcılara kullanıcının conversation'dan ayrıldığını bildir
    socket.to(conversationId).emit('user:left', {
      userId: socket.user.uid,
      conversationId,
      timestamp: Date.now()
    });
  });
  
  // Typing durumu - başlangıç
  socket.on('typing:start', (data: { conversationId: string }) => {
    const { conversationId } = data;
    socket.to(conversationId).emit('typing:start', {
      userId: socket.user.uid,
      conversationId,
      timestamp: Date.now()
    });
  });
  
  // Typing durumu - bitiş
  socket.on('typing:stop', (data: { conversationId: string }) => {
    const { conversationId } = data;
    socket.to(conversationId).emit('typing:stop', {
      userId: socket.user.uid,
      conversationId,
      timestamp: Date.now()
    });
  });
  
  // Mesaj okundu bildirimi
  socket.on('message:read', (data: { messageId: string; conversationId: string }) => {
    const { messageId, conversationId } = data;
    socket.to(conversationId).emit('message:read', {
      messageId,
      userId: socket.user.uid,
      conversationId,
      timestamp: Date.now()
    });
  });
  
  // Bağlantı koptuğunda
  socket.on('disconnect', () => {
    console.log(`User disconnected: ${socket.user.uid}`);
    
    // Kullanıcıyı aktif kullanıcılar listesinden çıkar
    activeUsers.delete(socket.user.uid);
    
    // Kullanıcının offline durumunu broadcast et
    socket.broadcast.emit('user:offline', {
      userId: socket.user.uid,
      timestamp: Date.now()
    });
  });
});

// Yardımcı fonksiyonlar - Socket.IO events
const emitMessageEvent = (eventType: string, messageData: any) => {
  const { conversationId } = messageData;
  io.to(conversationId).emit(eventType, messageData);
};

const emitToUser = (userId: string, eventType: string, data: any) => {
  const activeUser = activeUsers.get(userId);
  if (activeUser) {
    io.to(activeUser.socketId).emit(eventType, data);
  }
};

const emitToConversation = (conversationId: string, eventType: string, data: any) => {
  io.to(conversationId).emit(eventType, data);
};

const THUMB_MAX_WIDTH = 200;
const THUMB_MAX_HEIGHT = 200;
const MEDIUM_MAX_WIDTH = 800;
const MEDIUM_MAX_HEIGHT = 600;

// Image processing function that runs when files are uploaded (disabled in local emulator)
export const processImage = (process.env.FIREBASE_CONFIG ? onObjectFinalized(async (event) => {
  const object = event.data;
  const filePath = object.name;
  const contentType = object.contentType;

  // Exit if not an image
  if (!contentType || !contentType.startsWith('image/')) {
    console.log('Not an image file.');
    return null;
  }

  // Exit if already processed
  if (filePath?.includes('thumbnails/') || filePath?.includes('compressed/')) {
    console.log('Already processed image.');
    return null;
  }

  try {
    if (!sharp) {
      console.log('sharp missing, skipping image processing');
      return null;
    }
    const bucket = admin.storage().bucket(object.bucket);
    const fileName = path.basename(filePath!);
    const fileDir = path.dirname(filePath!);
    
    // Create paths for processed images
    const thumbFilePath = `${fileDir}/thumbnails/thumb_${fileName}`;
    const compressedFilePath = `${fileDir}/compressed/compressed_${fileName}`;
    
    const file = bucket.file(filePath!);
    const [fileBuffer] = await file.download();

    // Create thumbnail
    const thumbBuffer = await sharp(fileBuffer)
      .resize(THUMB_MAX_WIDTH, THUMB_MAX_HEIGHT, {
        fit: 'cover',
        position: 'center'
      })
      .jpeg({ quality: 80 })
      .toBuffer();

    // Create compressed version
    const compressedBuffer = await sharp(fileBuffer)
      .resize(MEDIUM_MAX_WIDTH, MEDIUM_MAX_HEIGHT, {
        fit: 'inside',
        withoutEnlargement: true
      })
      .jpeg({ quality: 85 })
      .toBuffer();

    // Save thumbnail
    await bucket.file(thumbFilePath).save(thumbBuffer, {
      metadata: {
        contentType: 'image/jpeg',
        metadata: {
          originalName: fileName,
          processedAt: new Date().toISOString(),
          type: 'thumbnail'
        }
      }
    });

    // Save compressed version
    await bucket.file(compressedFilePath).save(compressedBuffer, {
      metadata: {
        contentType: 'image/jpeg',
        metadata: {
          originalName: fileName,
          processedAt: new Date().toISOString(),
          type: 'compressed'
        }
      }
    });

    console.log(`Image processed: ${fileName}`);
    console.log(`Thumbnail created: ${thumbFilePath}`);
    console.log(`Compressed version created: ${compressedFilePath}`);

    return null;
  } catch (error) {
    console.error('Error processing image:', error);
    return null;
  }
}) : (undefined as any));

// Function to clean up processed images when original is deleted (disabled in local emulator)
export const cleanupProcessedImages = (process.env.FIREBASE_CONFIG ? onObjectDeleted(async (event) => {
  const object = event.data;
  const filePath = object.name;
  
  // Skip if it's already a processed image
  if (filePath?.includes('thumbnails/') || filePath?.includes('compressed/')) {
    return null;
  }

  try {
    const bucket = admin.storage().bucket(object.bucket);
    const fileName = path.basename(filePath!);
    const fileDir = path.dirname(filePath!);
    
    // Paths for processed images
    const thumbFilePath = `${fileDir}/thumbnails/thumb_${fileName}`;
    const compressedFilePath = `${fileDir}/compressed/compressed_${fileName}`;
    
    // Delete thumbnail if exists
    try {
      await bucket.file(thumbFilePath).delete();
      console.log(`Deleted thumbnail: ${thumbFilePath}`);
    } catch (error) {
      console.log(`Thumbnail not found or already deleted: ${thumbFilePath}`);
    }

    // Delete compressed version if exists
    try {
      await bucket.file(compressedFilePath).delete();
      console.log(`Deleted compressed version: ${compressedFilePath}`);
    } catch (error) {
      console.log(`Compressed version not found or already deleted: ${compressedFilePath}`);
    }

    return null;
  } catch (error) {
    console.error('Error cleaning up processed images:', error);
    return null;
  }
}) : (undefined as any));

